# AWS configuration
# Set these to match the AWS region and CloudWatch Logs log group
# receiving your VPC Flow Logs.
AWS_REGION=ap-south-1
AWS_FLOW_LOG_GROUP=/aws/vpc/flow-logs

# Local application database path.
# Pass this value when creating SecurityDatabase(db_path=...).
DB_PATH=data/security_monitor.db

# Optional: only set this if your VPC Flow Logs use a custom field order.
# The parser default is the standard version 2 format:
# version account-id interface-id srcaddr dstaddr srcport dstport protocol
# packets bytes start end action log-status
# FLOW_LOG_FIELDS=version account-id interface-id srcaddr dstaddr srcport dstport protocol packets bytes start end action log-status

# IMPORTANT:
# Do not add AWS_ACCESS_KEY_ID or AWS_SECRET_ACCESS_KEY here.
# Use an IAM role, AWS IAM Identity Center, or another supported
# temporary-credential provider. Never commit a real .env file.
